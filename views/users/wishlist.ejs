<% layout("/layouts/boilerplate") %>

<h2 class="text-center">My Wishlist</h2>

<% if(listings.length === 0) { %>

  <div class="text-center mt-5">
    <h3>No saved listings yet 💔</h3>
    <p>Start exploring and save your favorites!</p>
    <a href="/listings" class="btn btn-dark mt-2">Explore Listings</a>
  </div>

<% } else { %>

<div class="container mt-4">

  <p class="text-center text-muted mb-4">
    All your saved dreams stay here ❤️
  </p>

  <div class="row g-3">

    <% listings.forEach(listing => { %>

      <div class="col-12 col-md-6 col-lg-4 mb-4">

        <div class="card wishlist-card h-100 shadow-sm border-0">

          <div class="img-wrapper">
            <img src="<%= listing.image.url %>" class="card-img-top wishlist-img">
          </div>

          <div class="card-body d-flex flex-column">

            <h5 class="fw-bold mb-1"><%= listing.title %></h5>

            <p class="text-muted small mb-2">
              📍 <%= listing.location %>, <%= listing.country %>
            </p>

            <p class="fw-semibold text-danger mb-3">
              ₹ <%= listing.price.toLocaleString("en-IN") %> / night
            </p>

            <a href="/listings/<%= listing._id %>" class="btn btn-dark mt-auto w-100">
              View Details
            </a>

          </div>

        </div>

      </div>

    <% }) %>

  </div>
</div>

<% } %>